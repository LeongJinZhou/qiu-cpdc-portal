{
  "$comment": "POST /api/assessments/manage and PUT /api/assessments/manage/{id}: a whole self-assessment. Bands need one with min_percent 0 (checked on the server).",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "bands", "questions"],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 2000 },
    "answer_style": { "$comment": "likert: every question is rated 1-5 and the server writes the five options", "enum": ["choice", "likert"] },
    "reflection_prompts": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min_percent", "label"],
        "properties": {
          "min_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "options"],
        "properties": {
          "prompt": { "type": "string", "minLength": 3, "maxLength": 500 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "points"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 300 },
                "points": { "type": "integer", "minimum": 0, "maximum": 10 }
              }
            }
          }
        }
      }
    }
  }
}
