{
  "$comment": "PUT /api/surveys/{id}/response: a draft (submit false, any part answered) or the final answer (submit true: every item, programme and semester). Item and comment keys are checked against Cpdc\\Survey\\SurveyForm on the server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["answers", "comments", "submit"],
  "properties": {
    "programme": { "type": "string", "maxLength": 200 },
    "semester": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 12 }] },
    "answers": {
      "type": "object",
      "maxProperties": 80,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_]{1,40}$": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 5 }, { "const": "na" }] }
      }
    },
    "comments": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_]{1,40}$": { "type": "string", "maxLength": 4000 }
      }
    },
    "submit": { "type": "boolean" }
  }
}
