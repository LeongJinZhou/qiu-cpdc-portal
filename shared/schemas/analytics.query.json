{
  "$comment": "GET /api/analytics/overview and /api/analytics/export (CPDC). Dates are Malaysia days (display_timezone), both ends included.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "faculty": { "type": "string", "maxLength": 200 },
    "programme": { "type": "string", "maxLength": 200 },
    "role": { "enum": ["all", "student", "alumni"] },
    "cohort": { "type": "integer", "minimum": 1990, "maximum": 2100 },
    "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "report": { "enum": ["readiness", "outcomes"] }
  }
}
