{
  "$comment": "POST /api/jobs/manage and PUT /api/jobs/manage/{id}: a job or internship. skills = the level (1-5) the job asks for per skill area.",
  "type": "object",
  "additionalProperties": false,
  "required": ["employer_id", "title", "job_type", "location", "closing_date", "description"],
  "properties": {
    "employer_id": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "job_type": { "enum": ["full_time", "part_time", "internship", "contract"] },
    "location": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "closing_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
    "status": { "enum": ["draft", "open", "closed"] },
    "specializations": { "type": "string", "maxLength": 400 },
    "vacancy_count": { "type": ["integer", "null"], "minimum": 1, "maximum": 9999 },
    "duration_months": { "type": ["integer", "null"], "minimum": 1, "maximum": 120 },
    "salary_min": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000 },
    "salary_max": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000 },
    "pay_frequency": { "enum": ["monthly", "hourly", "lump_sum", "unpaid", "negotiable", null] },
    "min_qualification": { "type": "string", "maxLength": 160 },
    "work_experience": { "type": "string", "maxLength": 160 },
    "other_requirements": { "type": "string", "maxLength": 5000 },
    "benefits": { "type": "string", "maxLength": 5000 },
    "country": { "type": "string", "maxLength": 80 },
    "state": { "type": "string", "maxLength": 80 },
    "contact_email": { "type": "string", "maxLength": 254 },
    "skills": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area_id", "level"],
        "properties": {
          "area_id": { "type": "integer", "minimum": 1 },
          "level": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
