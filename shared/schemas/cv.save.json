{
  "$comment": "PUT /api/cv: what the CV adds to the career profile. Jobs, education and skills come from the profile; hidden_* name the profile entries the CV leaves out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contact", "headline", "summary", "hidden_experience", "hidden_education", "show_skills", "sections"],
  "properties": {
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "phone", "location", "website"],
      "properties": {
        "email": { "anyOf": [{ "const": "" }, { "type": "string", "format": "email", "maxLength": 254 }] },
        "phone": { "type": "string", "maxLength": 40, "pattern": "^[0-9+() -]*$" },
        "location": { "type": "string", "maxLength": 200 },
        "website": { "anyOf": [{ "const": "" }, { "type": "string", "maxLength": 300, "pattern": "^https://[^\\s]+$" }] }
      }
    },
    "headline": { "type": "string", "maxLength": 300 },
    "summary": { "type": "string", "maxLength": 3000 },
    "hidden_experience": { "type": "array", "maxItems": 30, "items": { "type": "integer", "minimum": 1 } },
    "hidden_education": { "type": "array", "maxItems": 20, "items": { "type": "integer", "minimum": 1 } },
    "show_skills": { "type": "boolean" },
    "academic": {
      "$comment": "slice B: CGPA (shown only when show_cgpa) and intake period, printed with education",
      "type": "object",
      "additionalProperties": false,
      "required": ["show_cgpa", "cgpa", "intake_period"],
      "properties": {
        "show_cgpa": { "type": "boolean" },
        "cgpa": { "anyOf": [{ "const": "" }, { "type": "string", "pattern": "^[0-4]\\.[0-9]{2}$" }] },
        "intake_period": { "type": "string", "maxLength": 60 }
      }
    },
    "courses_taken": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 120 } },
    "awards": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title"],
        "properties": {
          "kind": { "enum": ["deans_list", "award", "certificate"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "issuer": { "type": "string", "maxLength": 200 },
          "period": { "type": "string", "maxLength": 60 },
          "learning_id": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "cocurricular": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity"],
        "properties": {
          "activity": { "type": "string", "minLength": 1, "maxLength": 200 },
          "role_and_details": { "type": "string", "maxLength": 1000 },
          "period": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "designation", "company", "phone", "email"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "designation": { "type": "string", "maxLength": 120 },
          "company": { "type": "string", "maxLength": 200 },
          "phone": { "type": "string", "maxLength": 40, "pattern": "^[0-9+() -]*$" },
          "email": { "anyOf": [{ "const": "" }, { "type": "string", "format": "email", "maxLength": 254 }] }
        }
      }
    },
    "employer_sharing_consent": {
      "$comment": "PDPA: the person agrees that CPDC may share this CV with QIU partner employers; the server keeps the time",
      "type": "boolean"
    },
    "sections": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "items"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading"],
              "properties": {
                "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
                "sub": { "type": "string", "maxLength": 200 },
                "period": { "type": "string", "maxLength": 60 },
                "detail": { "type": "string", "maxLength": 1500 }
              }
            }
          }
        }
      }
    }
  }
}
